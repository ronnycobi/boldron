# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# The unanchored `build/` above (compile output) also matches the Flutter app's
# "build" FEATURE folder — re-include it so its source is tracked. Real Flutter
# build output stays ignored via frontend/.gitignore (/build/).
!frontend/lib/features/build/

# Virtualenvs (this project uses the shared ../env interpreter)
.venv/
env/
venv/

# Django
*.sqlite3
db.sqlite3
staticfiles/
media/
workspaces/

# Secrets / local config
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

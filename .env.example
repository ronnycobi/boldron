# Copy to .env (repo root) and fill in. NEVER commit the real .env (gitignored).
# settings.py loads this file on startup; real shell/host environment variables
# always win over anything set here. Override the path with DEVFORGE_ENV_FILE.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Application identity (white-label branding) ---
# The app is brand-agnostic: every customer-facing identity value comes from
# here. Set these to brand the whole product (UI, titles, meta/OG, emails, admin,
# generated README/listing text) with NO source changes. Unset values fall back
# to brand-neutral defaults, so the app still runs before you configure a brand.
APP_NAME=Application
# APP_COMPANY_NAME=            # legal/company name; falls back to APP_NAME
# APP_TAGLINE=Build software by describing it.
# APP_URL=https://yourbrand.com
# APP_LOGO_URL=                # full URL to a hosted logo; empty = bundled mark
# APP_FAVICON_URL=             # full URL to a favicon; empty = bundled mark
# APP_SUPPORT_EMAIL=support@yourbrand.com
# APP_SUPPORT_URL=
# APP_DEFAULT_LOCALE=en-us
# APP_DEFAULT_TIMEZONE=UTC
# APP_DEFAULT_CURRENCY=USD
# APP_BASE_DOMAIN=example.com          # subdomain zone for published sites
# APP_DOMAIN_TARGET=hosting.example.com # CNAME target shown in DNS instructions
# APP_BUNDLE_ID_PREFIX=com.example     # reverse-DNS prefix for generated app IDs

# --- Database ---
# Leave DB_ENGINE unset (or "sqlite") to use the bundled SQLite file for local
# dev. Set to "postgres" and fill the rest for the production target.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=app
# DB_USER=app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Production-only (ignored when DJANGO_DEBUG=true) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.yourbrand.com

# --- AI providers (Phase 6) — ENV ONLY, never hard-coded ---
# Which provider the gateway uses by default. "stub" (default) runs offline with
# no key; set "anthropic" for real completions and export ANTHROPIC_API_KEY.
# Set it to anthropic / openai / gemini and uncomment that provider's key.
AI_DEFAULT_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=            # or GOOGLE_API_KEY= (either is accepted)
